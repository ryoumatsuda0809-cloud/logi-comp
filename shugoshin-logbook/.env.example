# 動作確認用のダミー値。`cp .env.example .env` だけで `/demo`（DB に接続しない画面）が開く。
# ダミーのままでは Supabase に繋がらないので、ログインが要る画面は動かない。
# 実際の Supabase に繋ぐときは、「Project Settings → API」の値に差し替える。
# service_role キーは絶対にここへ入れないこと（公開キーのみ）。
VITE_SUPABASE_URL=https://dummy-project-ref.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=dummy-publishable-key
